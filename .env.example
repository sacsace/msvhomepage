# --- 방법 A: 분리 변수 (권장, .env.development 예시와 동일 패턴) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=msv
DB_USER=mvs_user
DB_PASSWORD=

# --- 방법 B: 한 줄 URL (있으면 A보다 우선) ---
# 로컬: sslmode=disable / 클라우드: sslmode=require (또는 플랫폼이 준 URL 그대로)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/msv?schema=public&sslmode=require

# SSL 을 `DB_*` 로만 조합할 때 (비우면 localhost 만 disable, 그 외 자동 require)
# DB_SSLMODE=require

# --- 최초 1회: 로컬에 mvs_user / msv DB 만들기 (`npm run db:bootstrap`) ---
# 슈퍼유저(postgres) 비밀번호 — .env.local 에만 두는 것을 권장합니다.
# POSTGRES_ADMIN_URL=postgresql://postgres:비밀번호@localhost:5432/postgres?sslmode=disable
# 또는 POSTGRES_SUPERUSER_PASSWORD=비밀번호

# 운영 DB도 같은 키·같은 Prisma 플로우: `.env.production.example` 참고.
# 로컬에서 운영 DB만 대상: MSV_MERGE_PRODUCTION=1 → npm run db:ping:prod / db:push:prod
#
# `npm run dev` 는 embedded Postgres(포트 기본 55432)를 자동 실행하고 `.msv-embedded.env` 를 만듭니다.
# Next 기동 시에는 `.msv-embedded-pg/.embedded-ready` 가 있을 때만 그 env 를 병합합니다(직접 `next dev`만 할 때 잘못된 URL 방지).
# 시스템 DB만 쓰려면 `npm run dev:no-embed` 또는 `.env.local` 에 MSV_IGNORE_EMBEDDED_ENV=1
# 잔존 `.msv-embedded.env` 만 강제 적용: MSV_FORCE_EMBEDDED_ENV=1
# 서버 기동 시 DB 연결 검사 끄기(임시): MSV_SKIP_DB_STARTUP_CHECK=1
# 검사 실패 시 dev 서버 즉시 중단(throw): MSV_ABORT_ON_DB_FAILURE=1 (예전: MSV_EXIT_ON_DB_FAILURE=1)
#
# 연결 실패 시 진단·embedded 자동 해제: `npm run db:doctor` (성공하면 `.env.local`에 MSV_IGNORE_EMBEDDED_ENV=1 기록 가능)

# 관리자 로그인 (/admin/login)
# 비밀번호: 시드 후 DB(AdminAuth)의 bcrypt 해시가 있으면 그것을 사용합니다. 기본 시드 비밀번호는 admin123 입니다.
# 환경 변수로만 쓰려면 아래를 채우고, 시드에서 AdminAuth를 비우거나 로그인 후 변경하세요.
# 둘 다 있으면 DB 해시가 우선합니다.
ADMIN_PASSWORD=

# JWT 서명용 비밀 (16자 이상). 운영(next start)에서는 필수입니다.
# next dev 에서는 개발용 기본 키가 쓰이므로 로컬에서 비워도 로그인할 수 있습니다.
ADMIN_SESSION_SECRET=

# LAN에서 http://192.168.x.x 처럼 IP+HTTP로 접속해 관리자 로그인할 때(운영 NODE_ENV=production 인 경우 등)
# 브라우저가 Secure 쿠키를 거부하면 1 로 설정. 내부망 전용 — 공인 인터넷에 노출된 운영 사이트에는 쓰지 마세요.
# ADMIN_COOKIE_ALLOW_HTTP=1
