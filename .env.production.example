# Next.js `next build` / `next start` 및 Prisma CLI(운영 대상)용 예시.
# 실제 값은 배포 플랫폼 Variables + (선택) `.env.production.local` 에만 두는 것을 권장합니다.
# 개발과 동일한 키 이름을 씁니다.

# --- 방법 A: 분리 변수 (개발 `.env.development` 와 동일 패턴) ---
DB_HOST=
DB_PORT=5432
DB_NAME=msv
DB_USER=mvs_user
DB_PASSWORD=

# 원격 DB에서 SSL 모드를 직접 지정하려면 (비우면 호스트가 localhost 가 아니면 require 로 조합됨)
# DB_SSLMODE=require

# --- 방법 B: 한 줄 URL (Railway 등에서 Reference 한 `DATABASE_URL` — 있으면 A보다 우선) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/msv?schema=public&sslmode=require

# --- 로컬 PC에서 운영 DB에만 Prisma 명령을 쏠 때 ---
# `web/.env.production` + `.env.production.local` 을 읽습니다.
#   npm run db:ping:prod
#   npm run db:push:prod
#   npm run db:seed:prod

# 관리자 / JWT (운영에서는 필수에 가깝습니다)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- 급여 명세 메일러 (Railway 등): UI에 비밀번호를 안 넣을 때 서버 env 로 SMTP 병합 ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
# PDF(급여): Linux/Railway는 비우면 @sparticuz/chromium. Windows는 비우면 설치된 Chrome 자동 탐색.
# 직접 지정 시 chrome.exe 등 실행 파일 전체 경로만(임시 폴더 경로 금지).
# PUPPETEER_EXECUTABLE_PATH=
