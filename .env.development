# ===========================================
# 데이터베이스 설정
# ===========================================
# `npm run dev` 는 embedded PostgreSQL(기본 포트 55432)을 띄우고 `.msv-embedded.env` 로
# 아래 값을 덮어씁니다. 시스템 Postgres 만 쓰려면 `npm run dev:no-embed` + init-db.sql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=msv
DB_USER=mvs_user
DB_PASSWORD=msv_local_dev_2026

# P1000(인증 실패) — dev:no-embed 또는 시스템 DB 사용 시:
# • pgAdmin/psql 로 위 사용자·비밀번호·DB 로 접속되는지 먼저 확인
# • 역할/DB 없으면 prisma/init-db.sql 또는 `npm run db:bootstrap`

# (선택) 한 줄 URL — 있으면 DB_* 조합보다 우선합니다.
# DATABASE_URL=

# 관리자 로그인 — DB AdminAuth 해시가 있으면 그쪽이 우선입니다. 없을 때 평문 폴백(로컬 전용).
ADMIN_PASSWORD=admin123

# JWT 서명 (운영 next start 에서는 16자 이상 필수). next dev 는 기본 키로 동작 가능.
# ADMIN_SESSION_SECRET=
